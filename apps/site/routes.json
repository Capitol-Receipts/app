{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/appointees.html",
      "destination": "/appointees",
      "permanent": true
    },
    {
      "source": "/delete-account.html",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/features.html",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/how-it-works.html",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/newsrooms.html",
      "destination": "/newsrooms",
      "permanent": true
    },
    {
      "source": "/parties.html",
      "destination": "/parties",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/quiz.html",
      "destination": "/quiz",
      "permanent": true
    },
    {
      "source": "/receipts.html",
      "destination": "/receipts",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/guides/:id/:slug",
      "destination": "/guides/:id",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://app.capitolreceipts.com",
      "permanent": false
    },
    {
      "source": "/leaderboards",
      "destination": "/receipts",
      "permanent": true
    },
    {
      "source": "/method",
      "destination": "/how-it-works",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pulse.json",
      "destination": "https://app.capitolreceipts.com/api/seo?t=pulse&via=www"
    },
    {
      "source": "/quiz/score/:n",
      "destination": "https://app.capitolreceipts.com/api/seo?t=quizscore&id=:n&via=www"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://app.capitolreceipts.com/api/seo?t=sitemap&via=www"
    },
    {
      "source": "/sitemaps/:f",
      "destination": "https://app.capitolreceipts.com/api/seo?t=sitemaps&id=:f&via=www"
    },
    {
      "source": "/es/:t(member|state|district|race|stock|official-trades)/:id/:slug",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&id=:id&slug=:slug&lang=es&via=www"
    },
    {
      "source": "/es/:t(member|state|district|race|stock|official-trades)/:id",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&id=:id&lang=es&via=www"
    },
    {
      "source": "/es/:t(members|states|elections)",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&lang=es&via=www"
    },
    {
      "source": "/guides",
      "destination": "https://app.capitolreceipts.com/guides?via=www"
    },
    {
      "source": "/guides/:id",
      "destination": "https://app.capitolreceipts.com/guides/:id?via=www"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district|stock|official-trades|reports)/:id/:slug",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&id=:id&slug=:slug&via=www"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district|stock|official-trades|reports)/:id",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&id=:id&via=www"
    },
    {
      "source": "/appointees/all",
      "destination": "https://app.capitolreceipts.com/seo-page?t=appointees&via=www"
    },
    {
      "source": "/:t(members|states|past-members|judges|bills|votes|pacs|lobbying|lobbying-firms|companies|committees|caucuses|elections|outside-groups|ethics|this-week|stocks|official-trades|reports)",
      "destination": "https://app.capitolreceipts.com/seo-page?t=:t&via=www"
    },
    {
      "source": "/rankings",
      "destination": "https://app.capitolreceipts.com/seo-page?t=rankings&via=www"
    },
    {
      "source": "/rankings/:id",
      "destination": "https://app.capitolreceipts.com/seo-page?t=rankings&id=:id&via=www"
    },
    {
      "source": "/rankings/:id/:slug",
      "destination": "https://app.capitolreceipts.com/seo-page?t=rankings&id=:id&slug=:slug&via=www"
    },
    {
      "source": "/llms.txt",
      "destination": "https://app.capitolreceipts.com/api/seo?t=llms&via=www"
    },
    {
      "source": "/llms-full.txt",
      "destination": "https://app.capitolreceipts.com/api/seo?t=llms-full&via=www"
    }
  ]
}
