{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.capitolreceipts.com",
      "permanent": false
    },
    {
      "source": "/leaderboards",
      "destination": "/receipts",
      "permanent": true
    },
    {
      "source": "/method",
      "destination": "/how-it-works",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://app.capitolreceipts.com/api/seo?t=sitemap&via=www"
    },
    {
      "source": "/sitemaps/:f",
      "destination": "https://app.capitolreceipts.com/api/seo?t=sitemaps&id=:f&via=www"
    },
    {
      "source": "/es/:t(member|state|district|race)/:id/:slug",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&id=:id&slug=:slug&lang=es&via=www"
    },
    {
      "source": "/es/:t(member|state|district|race)/:id",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&id=:id&lang=es&via=www"
    },
    {
      "source": "/es/:t(members|states|elections)",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&lang=es&via=www"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district)/:id/:slug",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&id=:id&slug=:slug&via=www"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district)/:id",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&id=:id&via=www"
    },
    {
      "source": "/appointees/all",
      "destination": "https://app.capitolreceipts.com/api/seo?t=appointees&via=www"
    },
    {
      "source": "/:t(members|states|past-members|judges|bills|votes|pacs|lobbying|lobbying-firms|companies|committees|caucuses|elections|outside-groups|ethics|this-week)",
      "destination": "https://app.capitolreceipts.com/api/seo?t=:t&via=www"
    },
    {
      "source": "/rankings",
      "destination": "https://app.capitolreceipts.com/api/seo?t=rankings&via=www"
    },
    {
      "source": "/rankings/:id",
      "destination": "https://app.capitolreceipts.com/api/seo?t=rankings&id=:id&via=www"
    },
    {
      "source": "/rankings/:id/:slug",
      "destination": "https://app.capitolreceipts.com/api/seo?t=rankings&id=:id&slug=:slug&via=www"
    },
    {
      "source": "/llms.txt",
      "destination": "https://app.capitolreceipts.com/api/seo?t=llms&via=www"
    }
  ]
}
