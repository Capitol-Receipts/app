{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.capitolreceipts.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "functions": {
    "api/seo.js": {
      "includeFiles": "index.html",
      "maxDuration": 30
    },
    "api/og.js": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 30,
      "memory": 1024
    },
    "api/db.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/go/:id",
      "destination": "/api/seo?t=go&id=:id"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?t=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?t=sitemap"
    },
    {
      "source": "/sitemaps/:f",
      "destination": "/api/seo?t=sitemaps&id=:f"
    },
    {
      "source": "/og/:t/:id",
      "destination": "/api/og?t=:t&id=:id"
    },
    {
      "source": "/embed/member/:id",
      "destination": "/api/seo?t=embed&id=:id"
    },
    {
      "source": "/es/:t(member|state|district|race)/:id/:slug",
      "destination": "/api/seo?t=:t&id=:id&slug=:slug&lang=es"
    },
    {
      "source": "/es/:t(member|state|district|race)/:id",
      "destination": "/api/seo?t=:t&id=:id&lang=es"
    },
    {
      "source": "/es/:t(members|states|elections)",
      "destination": "/api/seo?t=:t&lang=es"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district|stock)/:id/:slug",
      "destination": "/api/seo?t=:t&id=:id&slug=:slug"
    },
    {
      "source": "/:t(member|past-member|appointee|nominee|judge|bill|vote|pac|lobbying|lobbying-firm|company|committee|caucus|race|outside-group|ethics|state|district|stock)/:id",
      "destination": "/api/seo?t=:t&id=:id"
    },
    {
      "source": "/appointees/all",
      "destination": "/api/seo?t=appointees"
    },
    {
      "source": "/:t(members|states|past-members|appointees|judges|bills|votes|pacs|lobbying|lobbying-firms|companies|committees|caucuses|elections|outside-groups|ethics|this-week|stocks)",
      "destination": "/api/seo?t=:t"
    },
    {
      "source": "/rankings",
      "destination": "/api/seo?t=rankings"
    },
    {
      "source": "/rankings/:id",
      "destination": "/api/seo?t=rankings&id=:id"
    },
    {
      "source": "/rankings/:id/:slug",
      "destination": "/api/seo?t=rankings&id=:id&slug=:slug"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?t=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/seo?t=llms-full"
    }
  ],
  "redirects": [
    {
      "source": "/site/:path*",
      "destination": "https://www.capitolreceipts.com/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "app.capitolreceipts.com"
        }
      ],
      "destination": "https://admin.capitolreceipts.com/",
      "permanent": false
    }
  ]
}